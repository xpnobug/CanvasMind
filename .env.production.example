# =============================================================================
# 生产 / 线上环境模板
# 用法：复制为 .env.production 后填写真实值
# 读取：npm run start / docker compose / scripts/deploy-manual.sh
# =============================================================================

# --- 服务端口 ---
# 后端 API 监听端口（docker-compose 端口映射也依赖此值）
SERVER_PORT=5409

# --- 前端 / API 地址 ---
# 浏览器访问后端的公开地址（需与域名、反代一致）
VITE_API_BASE_URL=https://your-domain.com

# --- 静态资源与上传 ---
# Docker 容器内前端构建产物路径
STATIC_DIST_DIR=/app/dist
# Docker 容器内上传文件持久化目录（建议挂载 volume）
UPLOADS_DIR=/app/uploads

# --- 跨域 ---
# 允许访问 API 的前端域名，多个用英文逗号分隔
CORS_ALLOWED_ORIGINS=https://your-domain.com

# --- MySQL ---
# 线上库直连填真实地址；Docker 访问宿主机 MySQL 可用 host.docker.internal
# MySQL 8 非 SSL 连接建议加 ?allowPublicKeyRetrieval=true
DATABASE_URL=mysql://user:password@your-mysql-host:3306/canana_mind?allowPublicKeyRetrieval=true

# --- 加密密钥 ---
# 生产环境必须更换为足够长的随机字符串
PROVIDER_CONFIG_SECRET=please-change-this-provider-secret
STORAGE_CONFIG_SECRET=please-change-this-storage-secret

# --- 登录与会话 ---
AUTH_LOGIN_CODE_EXPIRE_MINUTES=5
AUTH_SESSION_EXPIRE_DAYS=30

# --- Redis ---
REDIS_ENABLED=true
# 独立 Redis 填真实 IP/域名；docker-compose 同栈 Redis 服务填 redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_URL=
REDIS_PREFIX=canana
REDIS_ENV=production

# --- Docker Compose 覆盖示例 ---
# APP_ENV_FILE=./.env.production
# 若 MySQL 在宿主机：DATABASE_URL=mysql://user:pass@host.docker.internal:3306/canana_mind?allowPublicKeyRetrieval=true
# 若 Redis 在同 compose 栈：REDIS_HOST=redis
