{
  "name": "canvasmind",
  "private": true,
  "version": "1.0.2",
  "description": "AI-powered infinite canvas for image generation and creative collaboration",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently --kill-others \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "npm run prisma:migrate:deploy:local && npm run prisma:generate && NODE_ENV=development tsx watch --env-file=.env.development server/index.ts",
    "preview": "vite preview",
    "start": "node scripts/start-production.mjs",
    "start:server": "node dist-service/server/index.js",
    "start:server:local": "NODE_ENV=development tsx --env-file=.env.development server/index.ts",
    "storage:mkdir": "node -e \"require('node:fs').mkdirSync('uploads',{recursive:true})\"",
    "type-check": "vue-tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:test:local": "node scripts/test-db-connection.mjs .env.development",
    "db:test:prod": "node scripts/test-db-connection.mjs .env.production",
    "prisma:migrate:deploy:local": "ENV_FILE=.env.development prisma migrate deploy",
    "prisma:migrate:deploy:prod": "ENV_FILE=.env.production prisma migrate deploy",
    "build": "npm run build:client",
    "build:client": "vue-tsc --noEmit && vite build",
    "build:service": "node scripts/build-server-service.mjs",
    "test:scripts": "node scripts/tests/run-all.mjs",
    "test:scripts:research": "tsx scripts/tests/test-research-task.mjs",
    "analyze": "ANALYZE=1 vite build",
    "class-suffix:scan": "python3 scripts/class_suffix_cleanup.py --write-report",
    "class-suffix:apply": "python3 scripts/class_suffix_cleanup.py --apply --all --write-report",
    "docker:build": "docker build -t canana-vue:latest .",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.917.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@hookform/resolvers": "^3.9.1",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@huggingface/transformers": "^3.8.1",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "echarts": "^5.6.0",
    "element-plus": "^2.13.1",
    "eventemitter3": "^5.0.1",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.469.0",
    "mediabunny": "^1.29.1",
    "motion": "^12.18.1",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.4",
    "prisma": "^7.8.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.7",
    "remixicon": "^4.9.1",
    "sonner": "^1.7.1",
    "streamdown": "^2.3.0",
    "tailwind-merge": "^2.5.5",
    "tianji-client-sdk": "^1.5.0",
    "use-deep-compare-effect": "^1.8.1",
    "vue": "^3.5.24",
    "vue-router": "^4.2.5",
    "wavesurfer.js": "^7.12.1",
    "zod": "^3.25.67",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.7",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.18",
    "terser": "^5.44.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.2.4",
    "vue-tsc": "^3.2.2"
  }
}
